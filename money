<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)} [hidden]{display:none!important}</style>
<title>우리집 가계부</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Gowun+Batang:wght@700&display=swap">
<style>
:root{
  --bg:#ffffff; --surface:#ffffff; --surface-2:#f6f6f3; --line:#e4e2da; --line-2:#d2d0c6;
  --ink:#1d1f1c; --ink-2:#575a55; --ink-3:#8a8d86;
  --accent:#1f6b5c; --accent-ink:#ffffff; --accent-soft:#e2efeb;
  --income:#2a78d6; --income-soft:#e4eefb; --expense:#e34948; --expense-soft:#fbe6e6; --saving:#1f6b5c; --saving-soft:#e2efeb;
  --grid:#e6e5de; --shadow:0 10px 30px rgba(29,31,28,.12);
  --radius:14px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#121412; --surface:#1b1e1b; --surface-2:#232624; --line:#2d312e; --line-2:#3b403c;
    --ink:#f1f1ec; --ink-2:#bfc2bb; --ink-3:#858880;
    --accent:#4fb39b; --accent-ink:#0e1a16; --accent-soft:#1c2f2a;
    --income:#3987e5; --income-soft:#172538; --expense:#e66767; --expense-soft:#3a1d1d; --saving:#4fb39b; --saving-soft:#1c2f2a;
    --grid:#2b2f2c; --shadow:0 10px 30px rgba(0,0,0,.45);
  }
}
:root[data-theme="dark"]{
  --bg:#121412; --surface:#1b1e1b; --surface-2:#232624; --line:#2d312e; --line-2:#3b403c;
  --ink:#f1f1ec; --ink-2:#bfc2bb; --ink-3:#858880;
  --accent:#4fb39b; --accent-ink:#0e1a16; --accent-soft:#1c2f2a;
  --income:#3987e5; --income-soft:#172538; --expense:#e66767; --expense-soft:#3a1d1d; --saving:#4fb39b; --saving-soft:#1c2f2a;
  --grid:#2b2f2c; --shadow:0 10px 30px rgba(0,0,0,.45);
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Noto Sans KR",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:15px;line-height:1.5;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;padding:0}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
input,select,textarea{font:inherit;color:var(--ink)}
.num{font-variant-numeric:tabular-nums}
.app{max-width:720px;margin:0 auto;padding-inline:16px;padding-block:0 92px;min-height:100%}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);padding-block:14px 8px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{font-family:"Gowun Batang",Georgia,serif;font-weight:700;font-size:22px;letter-spacing:-.01em}
.brand small{display:block;font-family:"Noto Sans KR",sans-serif;font-weight:400;font-size:11px;color:var(--ink-3);letter-spacing:.06em;text-transform:uppercase}
.sync{font-size:12px;color:var(--ink-3);display:flex;align-items:center;gap:6px}
.sync i{width:8px;height:8px;border-radius:50%;background:var(--ink-3);display:inline-block}
.sync.on i{background:var(--accent)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-block:8px 14px}
.nav h2{margin:0;font-size:19px;font-weight:700;letter-spacing:-.01em}
.nav .arrows{display:flex;gap:4px}
.nav .arrows button,.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:6px 12px;font-size:13px;color:var(--ink-2)}
.nav .arrows button{height:36px;padding:0 12px;display:grid;place-items:center;white-space:nowrap}
.nav .arrows button[aria-label]{width:36px;padding:0;font-size:18px}
.chip.on{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);font-weight:500}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.tiles{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:16px}
@media (max-width:520px){.tiles{grid-template-columns:repeat(2,1fr)}}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:12px 14px}
.tile .l{font-size:12px;color:var(--ink-3);letter-spacing:.04em}
.tile .v{font-size:18px;font-weight:700;margin-top:2px;letter-spacing:-.01em;word-break:keep-all}
.tile.inc .v{color:var(--income)} .tile.exp .v{color:var(--expense)} .tile.sav .v{color:var(--saving)}
@media (max-width:440px){.tile .v{font-size:15px}}
.notice{background:var(--accent-soft);color:var(--ink-2);border-radius:10px;padding:10px 14px;font-size:13px;margin-bottom:14px;display:flex;justify-content:space-between;gap:10px;align-items:center}
.notice b{color:var(--accent)}
.day{margin-bottom:6px}
.day-h{display:flex;justify-content:space-between;align-items:baseline;padding:10px 4px 4px;font-size:13px;color:var(--ink-3)}
.day-h b{color:var(--ink-2);font-weight:500}
.day-h .t{display:flex;gap:10px}
.day-h .t .i{color:var(--income)} .day-h .t .e{color:var(--expense)} .day-h .t .s{color:var(--saving)}
.items{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden}
.item{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:11px 14px;border-top:1px solid var(--line);width:100%;text-align:left}
.item:first-child{border-top:0}
.item:hover{background:var(--surface-2)}
.dot{width:12px;height:12px;border-radius:4px;flex:none}
.item .c{min-width:0}
.item .c .n{font-weight:500;font-size:14px}
.item .c .m{font-size:12px;color:var(--ink-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.item .a{font-weight:600;font-size:15px;white-space:nowrap}
.item .a.inc{color:var(--income)} .item .a.exp{color:var(--ink)} .item .a.sav{color:var(--saving)}
.cal{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:10px 8px;margin-bottom:14px}
.cal-h{display:grid;grid-template-columns:repeat(7,1fr);font-size:11px;color:var(--ink-3);text-align:center;margin-bottom:4px}
.cal-h span:first-child{color:var(--expense)} .cal-h span:last-child{color:var(--income)}
.cal-g{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
.cal-d{min-height:58px;border-radius:8px;padding:4px 3px;display:flex;flex-direction:column;align-items:center;gap:1px;font-size:10px;line-height:1.25;border:1px solid transparent}
.cal-d:hover{background:var(--surface-2)}
.cal-d .dn{font-size:12px;font-weight:500;color:var(--ink-2);width:22px;height:22px;border-radius:50%;display:grid;place-items:center}
.cal-d.today .dn{border:1.5px solid var(--accent);color:var(--accent)}
.cal-d.sel{background:var(--accent-soft);border-color:var(--accent)}
.cal-d.sel .dn{background:var(--accent);color:var(--accent-ink);border:0}
.cal-d.out{opacity:.35}
.cal-d.sun .dn{color:var(--expense)} .cal-d.sat .dn{color:var(--income)}
.cal-d .i{color:var(--income)} .cal-d .e{color:var(--expense)} .cal-d .s{color:var(--saving)}
.cal-d.fut .i,.cal-d.fut .e,.cal-d.fut .s{opacity:.55}
.item.sched .c .n::after{content:'예정';font-size:10px;color:var(--accent);background:var(--accent-soft);border-radius:4px;padding:1px 5px;margin-left:6px;vertical-align:1px}
.item.sched .a{opacity:.6}
.tiles-note{font-size:12px;color:var(--ink-3);margin:-8px 0 14px 2px}
.view-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.empty{text-align:center;color:var(--ink-3);padding:48px 16px;font-size:14px}
.fab{position:fixed;right:max(20px,calc(50% - 340px));bottom:calc(84px + env(safe-area-inset-bottom,0px));width:56px;height:56px;border-radius:50%;background:var(--accent);color:var(--accent-ink);font-size:30px;line-height:1;display:grid;place-items:center;box-shadow:var(--shadow);z-index:6}
.tabbar{position:fixed;left:0;right:0;bottom:0;background:var(--surface);border-top:1px solid var(--line);padding:6px 0 calc(6px + env(safe-area-inset-bottom,0px));z-index:6}
.tabbar .in{max-width:720px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr)}
.tabbar button{padding:6px 0 2px;font-size:11px;color:var(--ink-3);display:flex;flex-direction:column;align-items:center;gap:3px}
.tabbar button svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.tabbar button.on{color:var(--accent);font-weight:500}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:16px;margin-bottom:14px}
.card h3{margin:0 0 10px;font-size:14px;font-weight:700;display:flex;justify-content:space-between;align-items:center;gap:8px}
.card h3 span{font-weight:400;color:var(--ink-3);font-size:12px}
.seg{display:inline-flex;background:var(--surface-2);border:1px solid var(--line);border-radius:999px;padding:3px}
.seg button{padding:5px 12px;border-radius:999px;font-size:13px;color:var(--ink-2)}
.seg button.on{background:var(--surface);color:var(--ink);font-weight:500;box-shadow:0 1px 3px rgba(0,0,0,.12)}
.legend{display:flex;gap:14px;font-size:12px;color:var(--ink-2);margin-bottom:6px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
svg.chart{width:100%;height:auto;display:block;overflow:visible}
svg.chart text{font-family:inherit;fill:var(--ink-3);font-size:11px}
svg.donut text{font-size:12px}
svg.chart .grid{stroke:var(--grid);stroke-width:1}
svg.chart .base{stroke:var(--line-2);stroke-width:1}
svg.chart rect.bar{rx:2}
svg.chart rect.hit{fill:transparent}
svg.chart g.bk:hover rect.bar{opacity:.8}
.donut-wrap{display:grid;grid-template-columns:150px 1fr;gap:16px;align-items:center}
@media (max-width:480px){.donut-wrap{grid-template-columns:1fr}}
.ranks{display:flex;flex-direction:column;gap:8px}
.rank{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;font-size:13px}
.rank .bar{height:8px;border-radius:4px;background:var(--surface-2);overflow:hidden}
.rank .bar i{display:block;height:100%;border-radius:4px}
.rank .n{color:var(--ink-2);display:flex;align-items:center;gap:8px;min-width:80px}
.rank .v{color:var(--ink);font-weight:500;white-space:nowrap}
.rank .v small{color:var(--ink-3);font-weight:400;margin-left:4px}
.tip{position:fixed;pointer-events:none;background:var(--ink);color:var(--bg);font-size:12px;padding:6px 10px;border-radius:8px;z-index:20;white-space:nowrap;transform:translate(-50%,calc(-100% - 10px));opacity:0;transition:opacity .12s}
.tip.show{opacity:1}
.tip b{display:block;font-weight:500}
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{text-align:left;font-weight:500;color:var(--ink-3);padding:6px 4px;border-bottom:1px solid var(--line);font-size:12px}
.tbl td{padding:8px 4px;border-bottom:1px solid var(--line)}
.tbl td.r,.tbl th.r{text-align:right}
.tbl tr.tot td{font-weight:700;border-bottom:0}
.tbl .inc{color:var(--income)} .tbl .exp{color:var(--expense)} .tbl .sav{color:var(--saving)}
.tbl-wrap{overflow-x:auto}
.catlist{display:flex;flex-direction:column;gap:6px}
.catrow{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;background:var(--surface-2);border-radius:10px;padding:8px 10px}
.catrow .n{font-size:14px;font-weight:500}
.catrow .n small{color:var(--ink-3);font-weight:400;margin-left:6px;font-size:12px}
.catrow .ops{display:flex;gap:2px}
.catrow .ops button{width:30px;height:30px;border-radius:8px;color:var(--ink-3);display:grid;place-items:center}
.catrow .ops button:hover{background:var(--surface);color:var(--ink)}
.btn{border-radius:10px;padding:10px 16px;font-weight:500;font-size:14px;background:var(--surface-2);border:1px solid var(--line);color:var(--ink)}
.btn.pri{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.danger{color:var(--expense);border-color:transparent;background:transparent}
.btn.sm{padding:6px 12px;font-size:13px}
.btn:disabled{opacity:.5;cursor:default}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.field{display:flex;flex-direction:column;gap:5px;margin-bottom:14px}
.field label{font-size:12px;color:var(--ink-3);letter-spacing:.04em}
.field input,.field select,.field textarea{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:15px;width:100%}
.field input.amt{font-size:26px;font-weight:700;letter-spacing:-.01em;text-align:right;padding-right:14px}
.sheet-bg{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:10;display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--surface);width:100%;max-width:720px;border-radius:20px 20px 0 0;padding:18px 18px calc(18px + env(safe-area-inset-bottom,0px));max-height:92vh;overflow:auto;box-shadow:var(--shadow)}
.sheet h3{margin:0 0 14px;font-size:17px;display:flex;justify-content:space-between;align-items:center}
.sheet h3 button{color:var(--ink-3);font-size:22px;line-height:1}
.type-seg{display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--surface-2);border-radius:12px;padding:4px;margin-bottom:14px}
.type-seg button{padding:9px;border-radius:9px;font-weight:500;color:var(--ink-3)}
.type-seg button.exp.on{background:var(--expense-soft);color:var(--expense)}
.type-seg button.inc.on{background:var(--income-soft);color:var(--income)}
.type-seg button.sav.on{background:var(--saving-soft);color:var(--saving)}
.swatches{display:flex;gap:6px;flex-wrap:wrap}
.swatches button{width:26px;height:26px;border-radius:8px;border:2px solid transparent}
.swatches button.on{border-color:var(--ink)}
.subtle{font-size:12px;color:var(--ink-3);margin:6px 0 0}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>

</head>
<body>
<div class="app">
  <header class="top">
    <div class="brand">우리집 가계부<small>household ledger</small></div>
    <div class="sync" id="sync"><i></i><span>연결 중</span></div>
  </header>
  <main id="main"></main>
</div>
<button class="fab" id="fab" aria-label="내역 추가">+</button>
<nav class="tabbar"><div class="in">
  <button data-tab="home" class="on"><svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1z"/></svg>내역</button>
  <button data-tab="stats"><svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg>통계</button>
  <button data-tab="cats"><svg viewBox="0 0 24 24"><path d="M3 12l9-9 9 9-9 9zM12 8v8M8 12h8"/></svg>항목</button>
</div></nav>
<div class="tip" id="tip"></div>
<div id="sheet"></div>

<script>
(function(){
'use strict';
// ---------- helpers ----------
const $ = (s, r=document) => r.querySelector(s);
const el = (tag, attrs={}, ...kids) => { const n = document.createElement(tag); for (const [k,v] of Object.entries(attrs)) { if (v==null) continue; if (k==='class') n.className=v; else if (k.startsWith('on')) n.addEventListener(k.slice(2), v); else if (k==='html') n.innerHTML=v; else n.setAttribute(k,v);} for (const c of kids.flat()) if (c!=null) n.append(c.nodeType?c:document.createTextNode(c)); return n; };
const won = n => '₩' + Math.round(Math.abs(n)).toLocaleString('ko-KR');
const signed = n => (n<0?'−':'') + won(n);
const pad = n => String(n).padStart(2,'0');
const today = () => { const d=new Date(); return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; };
const ym = d => d.slice(0,7);
const uid = () => Math.random().toString(36).slice(2,10) + Date.now().toString(36);
const WD = ['일','월','화','수','목','금','토'];
const SW = ['#2a78d6','#eb6834','#1baf7a','#eda100','#e87ba4','#008300','#4a3aa7','#e34948','#7a5c3e','#5a9bd5','#c46aa0','#6b7280'];
const esc = s => String(s??'').replace(/[&<>"]/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

const DEFAULT_CATS = [
  ['식비','expense',0],['카페·간식','expense',1],['생활용품','expense',2],['주거·관리비','expense',3],['교통','expense',4],['의료·건강','expense',5],['쇼핑·의류','expense',6],['문화·여가','expense',7],['경조사·선물','expense',8],['기타지출','expense',11],
  ['급여','income',0],['부수입','income',2],['용돈·지원','income',4],['기타수입','income',11],
  ['적금','saving',2],['예금','saving',0],['투자','saving',6],['비상금','saving',3],
].map(([name,type,c],i)=>({id:'c'+(i+1), name, type, color:SW[c]}));

// ---------- state ----------
const S = {
  tab:'home', month: ym(today()), homeView:(function(){try{return localStorage.getItem('ledger.homeView')||'list'}catch(e){return 'list'}})(), selDay: today(),
  cats: null, members: ['나','배우자'], recurring: [], skipped: [],
  months: new Map(),       // 'YYYY-MM' -> items[]
  settingsLoaded:false, monthsLoaded:false,
  stats:{ mode:'month', date: today(), month: ym(today()), year: today().slice(0,4), kind:'expense' },
  storage:'none', db:null, sample:false,
};

// ---------- storage ----------
const writeQ = new Map();
function chain(key, fn){ const prev = writeQ.get(key) || Promise.resolve(); const p = prev.then(fn, fn); writeQ.set(key, p.catch(()=>{})); return p; }
function lsGet(k){ try { return JSON.parse(localStorage.getItem(k)); } catch(e){ return null; } }
function lsSet(k,v){ try { localStorage.setItem(k, JSON.stringify(v)); } catch(e){} }

async function saveMonth(key, items){
  S.months.set(key, items); S.sample=false; render();
  if (S.storage==='db') {
    return chain('m'+key, async()=>{ try { await S.db.doc('months/'+key).set({items}); } catch(e){ toast('저장에 실패했어요. 잠시 후 다시 시도해 주세요.'); } });
  } else { const all = lsGet('ledger.months')||{}; all[key]=items; lsSet('ledger.months', all); }
}
async function saveSettings(){
  const body = {cats:S.cats, members:S.members, recurring:S.recurring, skipped:S.skipped}; render();
  if (S.storage==='db') return chain('settings', async()=>{ try { await S.db.doc('settings/main').set(body); } catch(e){ toast('저장에 실패했어요.'); } });
  else lsSet('ledger.settings', body);
}

function setSync(on, text){ const s=$('#sync'); s.classList.toggle('on',on); s.querySelector('span').textContent=text; }

async function init(){
  const db = window.claude && window.claude.use ? await window.claude.use('db').catch(()=>null) : null;
  if (db) {
    S.db=db; S.storage='db'; setSync(true,'부부 공용 · 실시간 동기화');
    db.doc('settings/main').onSnapshot(snap=>{
      const d = snap.exists ? snap.data() : null;
      S.cats = (d && Array.isArray(d.cats) && d.cats.length) ? d.cats : (S.cats || DEFAULT_CATS.map(c=>({...c})));
      if (d && Array.isArray(d.members)) S.members = d.members;
      S.recurring = (d && Array.isArray(d.recurring)) ? d.recurring : []; S.skipped = (d && Array.isArray(d.skipped)) ? d.skipped : [];
      S.settingsLoaded=true; render(); applyRecurring();
    }, e=>{ setSync(false,'동기화 오류'); });
    db.collection('months').onSnapshot(snap=>{
      const m = new Map(); snap.docs.forEach(d=>{ const b=d.data(); if (b && Array.isArray(b.items)) m.set(d.id, b.items); });
      S.months = m; S.monthsLoaded=true; render(); applyRecurring();
    }, e=>{ setSync(false,'동기화 오류'); });
  } else {
    S.storage='local'; setSync(false,'이 기기에만 저장');
    const st = lsGet('ledger.settings'); S.cats = (st && st.cats && st.cats.length) ? st.cats : DEFAULT_CATS.map(c=>({...c})); if (st && st.members) S.members=st.members; if (st && st.recurring) S.recurring=st.recurring; if (st && st.skipped) S.skipped=st.skipped;
    const all = lsGet('ledger.months')||{}; S.months = new Map(Object.entries(all));
    S.settingsLoaded=S.monthsLoaded=true; render(); applyRecurring();
  }
}

// ---------- recurring ----------
let applying=false;
async function applyRecurring(){
  if (applying || !S.settingsLoaded || !S.monthsLoaded) return;
  applying=true;
