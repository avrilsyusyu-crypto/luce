    el('p',{class:'subtle'},'내역을 입력할 때 누가 썼는지 고를 수 있어요.')));
  if (S.storage==='local') wrap.append(el('div',{class:'card'}, el('h3',{},'백업 · 옮기기'),
    el('div',{class:'row'},
      el('button',{class:'btn',onclick:exportJson},'파일로 내보내기'),
      el('label',{class:'btn',style:'cursor:pointer'},'파일 가져오기', el('input',{type:'file',accept:'application/json,.json',id:'import-file',style:'display:none',onchange:importJson}))),
    el('p',{class:'subtle'},'내보낸 파일을 배우자 기기에서 가져오면 같은 내역을 볼 수 있어요. 가져오기는 기존 내역과 합쳐지고, 같은 내역은 중복되지 않아요.')));
  wrap.append(el('div',{class:'card'}, el('h3',{},'저장 위치'), el('p',{class:'subtle',style:'margin:0'}, S.storage==='db' ? '이 페이지를 열 수 있는 두 사람 모두 같은 내역을 보고, 입력하면 상대방 화면에도 바로 반영돼요.' : '지금은 이 기기의 브라우저에만 저장돼요. 공용 저장소에 연결되면 두 사람이 함께 볼 수 있어요.')));
  return wrap;
}
function exportJson(){
  const data={exportedAt:new Date().toISOString(), cats:S.cats, members:S.members, recurring:S.recurring, skipped:S.skipped, months:Object.fromEntries(S.months)};
  const blob=new Blob([JSON.stringify(data,null,1)],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`가계부-${today()}.json`; document.body.append(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
function importJson(e){
  const f=e.target.files[0]; if(!f) return; const rd=new FileReader();
  rd.onload=async()=>{ try{ const d=JSON.parse(rd.result); if(!d.months) throw 0;
    if (Array.isArray(d.cats)) { const ids=new Set(S.cats.map(c=>c.id)); S.cats=[...S.cats, ...d.cats.filter(c=>!ids.has(c.id))]; }
    if (Array.isArray(d.members)) S.members=d.members; if (Array.isArray(d.recurring)) { const ids=new Set(S.recurring.map(r=>r.id)); S.recurring=[...S.recurring,...d.recurring.filter(r=>!ids.has(r.id))]; }
    let n=0; for (const [k,items] of Object.entries(d.months)) { const cur=S.months.get(k)||[]; const have=new Set(cur.map(t=>t.id)); const add=items.filter(t=>!have.has(t.id)); n+=add.length; if (add.length) await saveMonth(k,[...cur,...add]); }
    await saveSettings(); toast(`${n}건을 가져왔어요`); } catch(err){ toast('가져올 수 없는 파일이에요.'); } e.target.value=''; };
  rd.readAsText(f);
}
function countFor(id){ let n=0; for (const a of S.months.values()) for (const t of a) if (t.cat===id) n++; return n; }
function moveCat(id,dir){ const i=S.cats.findIndex(c=>c.id===id); const j=(()=>{ for (let k=i+dir;k>=0&&k<S.cats.length;k+=dir) if (S.cats[k].type===S.cats[i].type) return k; return -1; })(); if (j<0) return; const a=[...S.cats]; [a[i],a[j]]=[a[j],a[i]]; S.cats=a; saveSettings(); }

function typeSeg(cur, onpick){
  const cls={expense:'exp',income:'inc',saving:'sav'}; const seg=el('div',{class:'type-seg'});
  for (const k of ['expense','income','saving']) seg.append(el('button',{class:cls[k]+(k===cur?' on':''),onclick:e=>{ onpick(k); [...seg.children].forEach(b=>b.classList.remove('on')); e.currentTarget.classList.add('on'); }}, TYPE_LABEL[k]));
  return seg;
}
function openRecForm(rule){
  const isNew=!rule; const d = rule ? {...rule} : {id:uid(), type:'expense', cat:'', amount:0, day:1, memo:'', who:S.members[0], start: ym(today())};
  const amt=el('input',{id:'rc-amount',class:'amt num',inputmode:'numeric',placeholder:'0',value:d.amount?d.amount.toLocaleString('ko-KR'):''});
  amt.addEventListener('input',()=>{ const v=amt.value.replace(/[^\d]/g,''); amt.value=v?Number(v).toLocaleString('ko-KR'):''; });
  const day=el('input',{id:'rc-day',type:'number',min:'1',max:'31',value:d.day});
  const start=el('input',{id:'rc-start',type:'month',value:d.start}); const end=el('input',{id:'rc-end',type:'month',value:d.end||''});
  const memo=el('input',{id:'rc-memo',value:d.memo,placeholder:'메모 (선택)',maxlength:'60'});
  const catBox=el('div',{class:'chips'}); const whoBox=el('div',{class:'chips'});
  const drawCats=()=>{ const list=S.cats.filter(c=>c.type===d.type); if(!list.find(c=>c.id===d.cat)) d.cat=list[0]?list[0].id:''; catBox.replaceChildren(...list.map(c=>el('button',{class:'chip'+(c.id===d.cat?' on':''),onclick:()=>{d.cat=c.id; drawCats();}}, c.name))); };
  const drawWho=()=>whoBox.replaceChildren(...S.members.map(m=>el('button',{class:'chip'+(m===d.who?' on':''),onclick:()=>{d.who=m; drawWho();}}, m)));
  drawCats(); drawWho();
  const body=el('div',{}, typeSeg(d.type, t=>{ d.type=t; drawCats(); }),
    el('div',{class:'field'}, el('label',{for:'rc-amount'},'금액 (원)'), amt),
    el('div',{class:'field'}, el('label',{},'항목'), catBox),
    el('div',{class:'row'}, el('div',{class:'field',style:'flex:1'}, el('label',{for:'rc-day'},'매월 며칠'), day), el('div',{class:'field',style:'flex:1'}, el('label',{for:'rc-start'},'시작 달'), start), el('div',{class:'field',style:'flex:1'}, el('label',{for:'rc-end'},'마지막 달 (선택)'), end)),
    el('div',{class:'field'}, el('label',{},'누가'), whoBox),
    el('div',{class:'field'}, el('label',{for:'rc-memo'},'메모'), memo),
    el('p',{class:'subtle',style:'margin:-6px 0 12px'},'시작 달부터 이번 달까지의 내역은 바로 기록되고, 다음 달 것은 예정으로 미리 표시돼요. 반복을 지워도 이미 기록된 내역은 남아요.'),
    el('div',{class:'row',style:'justify-content:space-between;margin-top:6px'},
      isNew?el('span'):el('button',{class:'btn danger',onclick:()=>{ if(!confirm('이 반복을 중단할까요? 이미 기록된 내역은 남아요.')) return; S.recurring=S.recurring.filter(r=>r.id!==d.id); saveSettings(); closeSheet(); }},'반복 중단'),
      el('div',{class:'row'}, el('button',{class:'btn',onclick:closeSheet},'취소'), el('button',{class:'btn pri',onclick:async()=>{ const v=Number(amt.value.replace(/[^\d]/g,'')); if(!v){amt.focus();return;} const dd=Math.min(31,Math.max(1,Number(day.value)||1)); if(!start.value){start.focus();return;}
        const rule={id:d.id,type:d.type,cat:d.cat,amount:v,day:dd,memo:memo.value.trim(),who:d.who,start:start.value}; if (end.value) rule.end=end.value;
        S.recurring = isNew ? [...S.recurring,rule] : S.recurring.map(r=>r.id===rule.id?rule:r); await saveSettings(); await applyRecurring(); closeSheet(); toast(isNew?'반복을 등록했어요':'수정했어요'); }}, isNew?'등록':'저장'))));
  openSheet(isNew?'매달 반복 추가':'매달 반복 수정', body); setTimeout(()=>amt.focus(),50);
}
function openCatForm(cat, type){
  const isNew=!cat; const draft = cat ? {...cat} : {id:'c'+uid(), name:'', type, color:SW[S.cats.filter(c=>c.type===type).length % SW.length]};
  const sw=el('div',{class:'swatches'}, SW.map(c=>el('button',{style:`background:${c}`,class:c===draft.color?'on':'','aria-label':c,onclick:e=>{draft.color=c; sw.querySelectorAll('button').forEach(b=>b.classList.toggle('on',b.style.background===e.currentTarget.style.background));}})));
  const name=el('input',{id:'cat-name',value:draft.name,placeholder:'예: 반려동물',maxlength:'20'});
  const body=el('div',{},
    el('div',{class:'field'}, el('label',{for:'cat-name'},'항목 이름'), name),
    el('div',{class:'field'}, el('label',{},'구분'), typeSeg(draft.type, t=>{draft.type=t;})),
    el('div',{class:'field'}, el('label',{},'색'), sw),
    el('div',{class:'row',style:'justify-content:space-between;margin-top:6px'},
      isNew?el('span'):el('button',{class:'btn danger',onclick:()=>{ const n=countFor(draft.id); if (n && !confirm(`이 항목으로 기록된 내역 ${n}건은 '미분류'로 표시돼요. 삭제할까요?`)) return; S.cats=S.cats.filter(c=>c.id!==draft.id); saveSettings(); closeSheet(); }},'삭제'),
      el('div',{class:'row'}, el('button',{class:'btn',onclick:closeSheet},'취소'), el('button',{class:'btn pri',onclick:()=>{ draft.name=name.value.trim(); if(!draft.name){ name.focus(); return; } if (isNew) S.cats=[...S.cats,draft]; else S.cats=S.cats.map(c=>c.id===draft.id?draft:c); saveSettings(); closeSheet(); }}, isNew?'추가':'저장'))));
  openSheet(isNew?'항목 추가':'항목 수정', body); setTimeout(()=>name.focus(),50);
}

// ---------- transaction form ----------
function openForm(t){
  const isNew=!t || String(t.id).startsWith('s');
  const d = t && !isNew ? {...t} : {id:uid(), date: (t&&t.date)|| (S.tab==='stats'&&S.stats.mode==='day'?S.stats.date: S.homeView==='cal'&&S.selDay.startsWith(S.month)?S.selDay: (ym(today())===S.month?today():S.month+'-01')), type:(t&&t.type)||'expense', cat:(t&&t.cat)||'', amount:(t&&t.amount)||0, memo:(t&&t.memo)||'', who:(t&&t.who)||S.members[0], ts:Date.now()};
  const origMonth = isNew?null:ym(t.date);
  const amt=el('input',{id:'tx-amount',class:'amt num',inputmode:'numeric',placeholder:'0',value:d.amount?d.amount.toLocaleString('ko-KR'):''});
  amt.addEventListener('input',()=>{ const v=amt.value.replace(/[^\d]/g,''); amt.value=v?Number(v).toLocaleString('ko-KR'):''; });
  const date=el('input',{id:'tx-date',type:'date',value:d.date});
  const memo=el('input',{id:'tx-memo',value:d.memo,placeholder:'메모 (선택)',maxlength:'60'});
  const catBox=el('div',{class:'chips'}); const whoBox=el('div',{class:'chips'});
  const drawCats=()=>{ const list=S.cats.filter(c=>c.type===d.type); if(!list.find(c=>c.id===d.cat)) d.cat=list[0]?list[0].id:''; catBox.replaceChildren(...list.map(c=>el('button',{class:'chip'+(c.id===d.cat?' on':''),onclick:()=>{d.cat=c.id; drawCats();}}, el('i',{class:'dot',style:`display:inline-block;width:8px;height:8px;border-radius:50%;background:${c.color};margin-right:6px;vertical-align:1px`}), c.name))); };
  const drawWho=()=>whoBox.replaceChildren(...S.members.map(m=>el('button',{class:'chip'+(m===d.who?' on':''),onclick:()=>{d.who=m; drawWho();}}, m)));
  drawCats(); drawWho();
  const seg=typeSeg(d.type, t=>{ d.type=t; drawCats(); });
  const save=async()=>{
    const v=Number(amt.value.replace(/[^\d]/g,'')); if(!v){ amt.focus(); return; } if(!date.value){ date.focus(); return; } if(!d.cat){ toast('항목을 먼저 추가해 주세요.'); return; }
    const item={id:d.id,date:date.value,type:d.type,cat:d.cat,amount:v,memo:memo.value.trim(),who:d.who,ts:d.ts};
    const key=ym(item.date);
    if (origMonth && origMonth!==key) await saveMonth(origMonth, (S.months.get(origMonth)||[]).filter(x=>x.id!==item.id));
    const cur=(S.months.get(key)||[]).filter(x=>x.id!==item.id); cur.push(item);
    S.month=key; S.selDay=item.date; if (S.stats.mode==='day') S.stats.date=item.date; S.stats.month=key; S.stats.year=key.slice(0,4);
    await saveMonth(key, cur); closeSheet(); toast(isNew?'저장했어요':'수정했어요');
  };
  const body=el('div',{}, seg,
    el('div',{class:'field'}, el('label',{for:'tx-amount'},'금액 (원)'), amt),
    el('div',{class:'field'}, el('label',{},'항목'), catBox),
    el('div',{class:'field'}, el('label',{for:'tx-date'},'날짜'), date),
    el('div',{class:'field'}, el('label',{},'누가'), whoBox),
    el('div',{class:'field'}, el('label',{for:'tx-memo'},'메모'), memo),
    el('div',{class:'row',style:'justify-content:space-between;margin-top:6px'},
      isNew?el('span'):el('button',{class:'btn danger',onclick:async()=>{ if(!confirm('이 내역을 삭제할까요?')) return; if (String(d.id).startsWith('r-')) { S.skipped=[...S.skipped,d.id]; saveSettings(); } await saveMonth(origMonth,(S.months.get(origMonth)||[]).filter(x=>x.id!==d.id)); closeSheet(); toast('삭제했어요'); }},'삭제'),
      el('div',{class:'row'}, el('button',{class:'btn',onclick:closeSheet},'취소'), el('button',{class:'btn pri',onclick:save}, isNew?'저장':'수정'))));
  openSheet(isNew?'내역 입력':'내역 수정', body); setTimeout(()=>amt.focus(),50);
}

function openSheet(title, body){
  const bg=el('div',{class:'sheet-bg',onclick:e=>{ if(e.target===bg) closeSheet(); }}, el('div',{class:'sheet',role:'dialog','aria-label':title}, el('h3',{}, title, el('button',{'aria-label':'닫기',onclick:closeSheet},'×')), body));
  $('#sheet').replaceChildren(bg);
}
function closeSheet(){ $('#sheet').replaceChildren(); }
document.addEventListener('keydown', e=>{ if (e.key==='Escape') closeSheet(); });
let toastT; function toast(msg){ let t=$('#toast'); if(!t){ t=el('div',{id:'toast',style:'position:fixed;left:50%;bottom:calc(100px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:8px 16px;border-radius:999px;font-size:13px;z-index:30;box-shadow:var(--shadow)'}); document.body.append(t); } t.textContent=msg; t.hidden=false; clearTimeout(toastT); toastT=setTimeout(()=>t.hidden=true,1800); }

// ---------- wiring ----------
document.querySelectorAll('.tabbar button').forEach(b=>b.addEventListener('click',()=>{ S.tab=b.dataset.tab; render(); }));
$('#fab').addEventListener('click',()=>openForm(null));
render(); init();
})();
