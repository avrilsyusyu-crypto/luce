      el('span',{class:'dot',style:`background:${c.color}`}),
      el('span',{class:'n'}, `매월 ${r.day}일 · ${c.name} `, el('b',{class:'num'}, won(r.amount)), el('small',{}, [TYPE_LABEL[r.type], r.memo, r.start+'부터'+(r.end?' '+r.end+'까지':'')].filter(Boolean).join(' · '))),
