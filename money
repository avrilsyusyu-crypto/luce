    const r2=mk('rect',{x:x0+bw+gap,y:y(x.expense),width:bw,height:Math.max(0,T+ph-y(x.expense)),fill:'var(--expense)',class:'bar'});
    const hit=mk('rect',{x:L+i*slot,y:T,width:slot,height:ph,class:'hit'});
    g.append(r1,r2,hit);
    const show=ev=>{ tipShow(ev, `<b>${esc(x.label)}</b>수입 ${won(x.income)}<br>지출 ${won(x.expense)}`); };
    g.addEventListener('mouseenter',show); g.addEventListener('mousemove',show); g.addEventListener('mouseleave',tipHide); g.addEventListener('click',show);
