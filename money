  for (const p of parts){ const frac=p.value/total; const len=Math.max(0,frac*C-2); const c=document.createElementNS(ns,'circle');
    c.setAttribute('cx',cx); c.setAttribute('cy',cy); c.setAttribute('r',r); c.setAttribute('fill','none'); c.setAttribute('stroke',p.color); c.setAttribute('stroke-width','18');
    c.setAttribute('stroke-dasharray',`${len} ${C-len}`); c.setAttribute('stroke-dashoffset', -off); c.setAttribute('transform',`rotate(-90 ${cx} ${cy})`);
    const show=ev=>tipShow(ev,`<b>${esc(p.name)}</b>${won(p.value)} · ${Math.round(frac*100)}%`); c.addEventListener('mouseenter',show); c.addEventListener('mousemove',show); c.addEventListener('mouseleave',tipHide); c.addEventListener('click',show);
    svg.append(c); off+=frac*C; }
  const t1=document.createElementNS(ns,'text'); t1.setAttribute('x',cx); t1.setAttribute('y',cy-4); t1.setAttribute('text-anchor','middle'); t1.textContent='합계'; svg.append(t1);
  const t2=document.createElementNS(ns,'text'); t2.setAttribute('x',cx); t2.setAttribute('y',cy+14); t2.setAttribute('text-anchor','middle'); t2.setAttribute('font-weight','700'); t2.setAttribute('style','fill:var(--ink);font-size:12px'); t2.textContent=short(total)+(total<1e4?'원':''); svg.append(t2);
  return svg;
}
function tipShow(ev, html){ const t=$('#tip'); t.innerHTML=html; t.style.left=ev.clientX+'px'; t.style.top=ev.clientY+'px'; t.classList.add('show'); }
function tipHide(){ $('#tip').classList.remove('show'); }
document.addEventListener('click', e=>{ if (!e.target.closest('svg.chart')) tipHide(); });

// ---------- categories ----------
function viewCats(){
